#!/bin/bash
# =============================================================================
# image-backup — x86_64 Ubuntu 24.04 / Debian 13
# Live-system bootable .img backup with UEFI, Secure Boot, and LUKS+LVM support
#
# Based on RonR's Image File Utilities for Raspberry Pi
#   Original: https://forums.raspberrypi.com/viewtopic.php?t=332000
#   Adapted:  https://github.com/Danrancan/Image-File-Utilities-X86_64
#
# Supports:
#   - Unencrypted ext4 root partitions
#   - LUKS-encrypted LVM ext4 root partitions (Ubuntu/Debian default layout)
#   - UEFI boot only (GPT + EFI System Partition)
#   - Secure Boot (installs shim + signed GRUB binaries when available)
#   - Automatic shrink of root filesystem to minimum size after initial backup
#   - Incremental rsync updates to existing image files
#
# Partition layouts produced:
#   Unencrypted (2-part):  p1=EFI(vfat 512M)  p2=root(ext4)
#   Unencrypted (3-part):  p1=EFI(vfat 512M)  p2=/boot(ext4 1G)  p3=root(ext4)
#   LUKS/LVM    (3-part):  p1=EFI(vfat 512M)  p2=/boot(ext4 1G)  p3=LUKS->LVM->ext4
#
# Usage:
#   image-backup [options] [/path/to/existing.img]   <- incremental update
#   image-backup -i /path/to/new.img                 <- non-interactive initial
#   image-backup                                     <- interactive initial
# =============================================================================


# Wait for udev to create partition device nodes on a loop device.
# Without this, e2fsck/mount can fire before ${LOOP}pN exists.
loop_settle()
{
  local DEV="$1"
  udevadm settle 2>/dev/null
  local TRIES=0
  while [ ! -e "${DEV}p1" ] && [ ${TRIES} -lt 40 ]; do
    sleep 0.25
    partprobe "${DEV}" 2>/dev/null
    udevadm settle 2>/dev/null
    TRIES=$((TRIES + 1))
  done
  if [ ! -e "${DEV}p1" ]; then
    echo "" >&2
    echo "ERROR: partition devices for ${DEV} never appeared." >&2
    echo "Try: sudo partprobe ${DEV}" >&2
    return 1
  fi
  return 0
}

# Count partitions in an image file via its GPT/MBR table.
# NOTE: do NOT use `lsblk | grep -c 'p[0-9]'` -- the parent device name
# ("loop48") itself contains "p4" and gets counted as a partition.
fs_uuid()
{
  # Probe the device directly; the blkid cache can be empty or stale for
  # filesystems that were created seconds ago on a recycled loop device.
  local DEV="$1" U
  U="$(blkid -p -s UUID -o value "${DEV}" 2>/dev/null)"
  [ -z "${U}" ] && U="$(blkid -c /dev/null -s UUID -o value "${DEV}" 2>/dev/null)"
  echo "${U}"
}

count_parts()
{
  local IMG="$1"
  sfdisk -d "${IMG}" 2>/dev/null | grep -c ': start='
}

# Get the first sector of partition N in an image file.
# sgdisk -i is used because sfdisk -d writes "<file>N : start=" with no
# whitespace before N, which defeated the previous grep pattern.
part_start()
{
  local IMG="$1" N="$2"
  sgdisk -i "${N}" "${IMG}" 2>/dev/null \
    | sed -n 's|^First sector: \([0-9]*\).*|\1|p'
}

trap '{ stty sane; echo ""; errexit "Aborted"; }' SIGINT SIGTERM

MNTPATH="/tmp/img-backup-mnt"
ONEMB=$((1024 * 1024))

# Global state
LOOP=""
MNTED=FALSE
IMG_MAPPER_OPEN=FALSE
IMG_LUKS_PASSPHRASE=""
IMG_LUKS_MAPPER=""
IMG_VG_NAME=""
IMG_LV_NAME=""
IMG_LV_PATH=""
ENCRYPTED=FALSE
THREE_PART=FALSE
ROOT_PART_NUM=2

# =============================================================================
# UTILITY FUNCTIONS
# =============================================================================

errexit()
{
  echo ""
  echo -e "$1"
  echo ""
  _cleanup_mounts
  rmloop
  exit 1
}

_cleanup_mounts()
{
  if [ "${MNTED}" = "TRUE" ]; then
    umount "${MNTPATH}/dev/pts"  &> /dev/null
    umount "${MNTPATH}/dev"      &> /dev/null
    umount "${MNTPATH}/sys"      &> /dev/null
    umount "${MNTPATH}/proc"     &> /dev/null
    umount "${MNTPATH}/run"      &> /dev/null
    umount "${MNTPATH}/boot/efi" &> /dev/null
    umount "${MNTPATH}/boot"     &> /dev/null
    umount "${MNTPATH}/"         &> /dev/null
    MNTED=FALSE
  fi
  if [ "${IMG_MAPPER_OPEN}" = "TRUE" ]; then
    _deactivate_image_lvm
    cryptsetup close "${IMG_LUKS_MAPPER}" &> /dev/null
    IMG_MAPPER_OPEN=FALSE
  fi
  rm -rf "${MNTPATH}/" &> /dev/null
}

mkloop()
{
  LOOP="$(losetup -f --show -P "${IMGFILE}")"
  [ $? -ne 0 ] && errexit "Unable to create loop device"
  loop_settle "${LOOP}" || errexit "Loop partition devices did not appear"
}

rmloop()
{
  if [ "${LOOP}" != "" ]; then
    losetup -d "${LOOP}" &> /dev/null
    LOOP=""
  fi
}

fsckerr()
{
  errexit "Filesystem appears corrupted ($1 resize2fs) — run: image-check ${IMGFILE}"
}

usage()
{
  errexit "Usage: $0 [options] [pathto/imagefile for incremental backup]

Options:
  -h, --help        This usage description
  -i, --initial     pathto/filename [,initial root size MB [,added space MB]]
  -n, --noexpand    Do not auto-expand filesystem on first boot after restore
  -o, --options     Additional rsync options (comma-separated)
  -u, --ubuntu      Force Ubuntu mode (normally auto-detected)
  -p, --passphrase  LUKS passphrase for the image (avoids interactive prompt)
                    Only used when the live root is LUKS-encrypted"
}

check_dep()
{
  local DEP="$1" PKG="$2"
  if ! command -v "${DEP}" &> /dev/null; then
    echo ""
    echo "Required tool not found: ${DEP}"
    echo -n "Ok to install ${PKG} now (y/n)? "
    while read -r -n 1 -s answer; do
      if [[ "${answer}" = [yYnN] ]]; then
        echo "${answer}"
        if [[ "${answer}" = [yY] ]]; then
          break
        else
          errexit "Aborted — please install: apt-get install ${PKG}"
        fi
      fi
    done
    echo ""
    apt-get update -qq
    apt-get install -y "${PKG}"
    command -v "${DEP}" &> /dev/null || errexit "Installation of ${PKG} failed"
  fi
}

# =============================================================================
# ENCRYPTION DETECTION
# Sets: ENCRYPTED, LUKS_DEV, LUKS_UUID, MAPPER_NAME, VG_NAME, LV_NAME, LV_PATH
# =============================================================================

detect_encryption()
{
  ENCRYPTED=FALSE
  LUKS_DEV=""; LUKS_UUID=""; MAPPER_NAME=""
  VG_NAME=""; LV_NAME=""; LV_PATH=""; ROOT_DISK=""

  # Full device chain for the root filesystem, innermost first.
  #
  # -r (raw) is essential. Without it lsblk draws a tree and device names
  # come back as "|-dm_crypt-0", which silently breaks every lookup built
  # on them. -p returns full device paths. A typical LVM-on-LUKS root:
  #
  #   /dev/mapper/ubuntu--vg-ubuntu--lv lvm
  #   /dev/mapper/dm_crypt-0            crypt
  #   /dev/nvme0n1p3                    part
  #   /dev/nvme0n1                      disk
  local CHAIN
  CHAIN="$(lsblk -rpsno NAME,TYPE "${ROOT_PART}" 2>/dev/null)"
  [ -z "${CHAIN}" ] && errexit "Unable to read the device chain for ${ROOT_PART}"

  ROOT_DISK="$(awk '$2=="disk"{print $1; exit}' <<< "${CHAIN}")"

  if awk '$2=="crypt"{f=1} END{exit !f}' <<< "${CHAIN}"; then
    # dm-crypt layer somewhere beneath the root filesystem
    ENCRYPTED=TRUE
    check_dep cryptsetup cryptsetup
    check_dep lvs        lvm2

    local MAPPER_DEV
    MAPPER_DEV="$(awk '$2=="crypt"{print $1; exit}' <<< "${CHAIN}")"
    MAPPER_NAME="$(basename "${MAPPER_DEV}")"

    # First real block device beneath the crypt layer holds the LUKS header
    LUKS_DEV="$(awk '$2=="crypt"{seen=1; next}
                     seen && ($2=="part" || $2=="disk"){print $1; exit}' <<< "${CHAIN}")"
    LUKS_UUID="$(fs_uuid "${LUKS_DEV}")"

    # LVM inside the container?
    if [ "$(awk 'NR==1{print $2}' <<< "${CHAIN}")" = "lvm" ]; then
      VG_NAME="$(lvs --noheadings -o vg_name "${ROOT_PART}" 2>/dev/null | tr -d ' ')"
      LV_NAME="$(lvs --noheadings -o lv_name "${ROOT_PART}" 2>/dev/null | tr -d ' ')"
      LV_PATH="${ROOT_PART}"
    fi

  elif [ "$(blkid -p -s TYPE -o value "${ROOT_PART}" 2>/dev/null)" = "crypto_LUKS" ]; then
    # LUKS directly on the root partition, no LVM
    ENCRYPTED=TRUE
    check_dep cryptsetup cryptsetup
    LUKS_DEV="${ROOT_PART}"
    LUKS_UUID="$(fs_uuid "${LUKS_DEV}")"
    MAPPER_NAME="$(awk '!/^[[:space:]]*#/ && /UUID='"${LUKS_UUID}"'/{print $1}' \
                  /etc/crypttab 2>/dev/null | head -1)"
    [ -z "${MAPPER_NAME}" ] && MAPPER_NAME="crypt_root"
    LV_PATH="/dev/mapper/${MAPPER_NAME}"
  fi

  if [ "${ENCRYPTED}" = "TRUE" ]; then
    # Refuse to continue on a half-resolved chain rather than failing later
    # with a confusing message.
    if [ -z "${LUKS_DEV}" ] || [ ! -b "${LUKS_DEV}" ] || [ -z "${LUKS_UUID}" ]; then
      echo ""
      echo "Device chain reported by lsblk:"
      echo "${CHAIN}" | sed 's/^/    /'
      errexit "Could not resolve the LUKS container for ${ROOT_PART}.\nResolved: LUKS_DEV='${LUKS_DEV}' UUID='${LUKS_UUID}'"
    fi
    echo "  Encrypted root detected:"
    echo "    LUKS device : ${LUKS_DEV}"
    echo "    LUKS UUID   : ${LUKS_UUID}"
    echo "    Mapper name : ${MAPPER_NAME}"
    [ -n "${VG_NAME}" ] && echo "    LVM VG      : ${VG_NAME}"
    [ -n "${LV_NAME}" ] && echo "    LVM LV      : ${LV_NAME}"

    # Only the root LV is cloned. Any other LV in the VG (a separate /home,
    # for example) is a different filesystem and is NOT copied.
    if [ -n "${VG_NAME}" ]; then
      local OTHER_LVS
      OTHER_LVS="$(lvs --noheadings -o lv_name "${VG_NAME}" 2>/dev/null \
                   | tr -d ' ' | grep -v "^${LV_NAME}$" | tr '\n' ' ')"
      if [ -n "${OTHER_LVS}" ]; then
        echo ""
        echo "  NOTE: volume group ${VG_NAME} also contains: ${OTHER_LVS}"
        echo "        Only the root volume (${LV_NAME}) is cloned into the image."
      fi
    fi
  fi
}

# Filesystems mounted outside /, /boot and /boot/efi are skipped by rsync -x
# and will be EMPTY in the image. Say so plainly before any copying starts.
_warn_skipped_mounts()
{
  local SKIPPED
  SKIPPED="$(findmnt -rno TARGET,SOURCE,FSTYPE \
    | awk '$3 !~ /^(proc|sysfs|devtmpfs|devpts|tmpfs|ramfs|squashfs|overlay|autofs|cgroup|cgroup2|securityfs|pstore|efivarfs|bpf|mqueue|hugetlbfs|debugfs|tracefs|fusectl|configfs|nsfs|binfmt_misc|rpc_pipefs|iso9660|vfat)$/ &&
           $1 != "/" && $1 != "/boot" && $1 != "/boot/efi" &&
           $1 !~ /^\/(dev|proc|sys|run|tmp|snap|media|mnt|var\/snap|var\/lib\/docker)(\/|$)/ {
             printf "    %-28s %s (%s)\n", $1, $2, $3 }')"
  if [ -n "${SKIPPED}" ]; then
    echo ""
    echo "  These mounted filesystems are NOT included in the image:"
    echo "${SKIPPED}"
    echo "  Their mount points will exist but be empty after a restore."
  fi
}

# =============================================================================
# LUKS / LVM IMAGE LIFECYCLE
# =============================================================================

# Open the LUKS container inside the image and activate its LVM VG
# Sets: IMG_LUKS_MAPPER, IMG_VG_NAME, IMG_LV_NAME, IMG_LV_PATH
_open_image_luks()
{
  IMG_LUKS_MAPPER="imgcrypt$(date +%s)"
  echo "  Opening LUKS container in image..."
  echo -n "${IMG_LUKS_PASSPHRASE}" | \
    cryptsetup luksOpen "${LOOP}p${ROOT_PART_NUM}" "${IMG_LUKS_MAPPER}" --key-file=-
  [ $? -ne 0 ] && errexit "Failed to open LUKS container in image — wrong passphrase?"
  IMG_MAPPER_OPEN=TRUE

  if [ -n "${VG_NAME}" ]; then
    IMG_VG_NAME="${VG_NAME}img"
    IMG_LV_NAME="${LV_NAME}"
    vgchange -ay "${IMG_VG_NAME}" &> /dev/null
    IMG_LV_PATH="/dev/${IMG_VG_NAME}/${IMG_LV_NAME}"
  else
    IMG_LV_PATH="/dev/mapper/${IMG_LUKS_MAPPER}"
  fi
}

_deactivate_image_lvm()
{
  if [ -n "${IMG_VG_NAME}" ]; then
    sync
    vgchange -an "${IMG_VG_NAME}" &> /dev/null
  fi
}

setup_luks_image()
{
  echo ""
  echo "Setting up LUKS encrypted container in image..."

  if [ -z "${IMG_LUKS_PASSPHRASE}" ]; then
    local P1 P2
    while :; do
      echo -n "  Enter passphrase for image LUKS container: "
      read -rs P1; echo ""
      echo -n "  Confirm passphrase: "
      read -rs P2; echo ""
      if [ "${P1}" = "${P2}" ] && [ -n "${P1}" ]; then
        IMG_LUKS_PASSPHRASE="${P1}"
        break
      elif [ -z "${P1}" ]; then
        echo "  Passphrase cannot be empty."
      else
        echo "  Passphrases do not match."
      fi
    done
  fi

  echo -n "${IMG_LUKS_PASSPHRASE}" | \
    cryptsetup luksFormat \
      --type luks2 \
      --cipher aes-xts-plain64 \
      --key-size 512 \
      --hash sha256 \
      --iter-time 2000 \
      --key-file=- \
      "${LOOP}p${ROOT_PART_NUM}"
  [ $? -ne 0 ] && errexit "cryptsetup luksFormat failed"

  _open_image_luks

  if [ -n "${VG_NAME}" ]; then
    echo "  Creating LVM inside LUKS container..."
    pvcreate -y -ff "/dev/mapper/${IMG_LUKS_MAPPER}" &> /dev/null || errexit "pvcreate failed"
    vgcreate -y "${IMG_VG_NAME}" "/dev/mapper/${IMG_LUKS_MAPPER}" &> /dev/null || errexit "vgcreate failed"
    lvcreate -y -l 100%FREE -n "${IMG_LV_NAME}" "${IMG_VG_NAME}" &> /dev/null || errexit "lvcreate failed"
    IMG_LV_PATH="/dev/${IMG_VG_NAME}/${IMG_LV_NAME}"
  fi

  echo "  Formatting root filesystem (ext4)..."
  mkfs.ext4 -b 4096 -L rootfs -q "${IMG_LV_PATH}" > /dev/null || errexit "mkfs.ext4 failed"
  echo "  LUKS container ready."
}

# =============================================================================
# MOUNT / UNMOUNT IMAGE
# =============================================================================

mntimg()
{
  mkloop
  mkdir -p "${MNTPATH}/"

  if [ "${ENCRYPTED}" = "TRUE" ]; then
    _open_image_luks
    mount "${IMG_LV_PATH}" "${MNTPATH}/" || errexit "Unable to mount image root LV"
  else
    mount "${LOOP}p${ROOT_PART_NUM}" "${MNTPATH}/" || errexit "Unable to mount image ROOT"
  fi
  MNTED=TRUE

  if [ "${THREE_PART}" = "TRUE" ]; then
    mkdir -p "${MNTPATH}/boot/"
    mount "${LOOP}p2" "${MNTPATH}/boot/" || errexit "Unable to mount image /boot"
  fi
  mkdir -p "${MNTPATH}/boot/efi/"
  mount "${LOOP}p1" "${MNTPATH}/boot/efi/" || errexit "Unable to mount image EFI"
}

umntimg()
{
  umount "${MNTPATH}/boot/efi/" &> /dev/null
  [ "${THREE_PART}" = "TRUE" ] && umount "${MNTPATH}/boot/" &> /dev/null
  umount "${MNTPATH}/" &> /dev/null
  MNTED=FALSE

  if [ "${ENCRYPTED}" = "TRUE" ] && [ "${IMG_MAPPER_OPEN}" = "TRUE" ]; then
    _deactivate_image_lvm
    cryptsetup close "${IMG_LUKS_MAPPER}" &> /dev/null
    IMG_MAPPER_OPEN=FALSE
  fi

  rmloop
  rm -rf "${MNTPATH}/"
}

# =============================================================================
# GRUB / SECURE BOOT
# =============================================================================

install_grub()
{
  echo ""
  echo "Installing GRUB EFI bootloader into image..."

  mount --bind /dev     "${MNTPATH}/dev"
  mount --bind /dev/pts "${MNTPATH}/dev/pts"
  mount --bind /sys     "${MNTPATH}/sys"
  mount -t proc proc    "${MNTPATH}/proc"
  mount --bind /run     "${MNTPATH}/run"

  # Resolver inside chroot, so apt/grub can work if network is available
  if [ ! -s "${MNTPATH}/etc/resolv.conf" ]; then
    cp /etc/resolv.conf "${MNTPATH}/etc/resolv.conf" 2>/dev/null
  fi

  if [ ! -f "${MNTPATH}/usr/sbin/grub-install" ]; then
    echo "  Installing grub-efi-amd64 in image chroot..."
    chroot "${MNTPATH}" apt-get install -y --no-install-recommends \
      grub-efi-amd64 grub-efi-amd64-bin &> /dev/null
  fi

  # ---- Determine bootloader-id (distro directory name on the ESP) ----
  # Ubuntu derivatives (incl. Zorin) ship a SIGNED grubx64.efi whose prefix
  # is baked in as /EFI/<id>. That binary CANNOT read /boot/grub/grub.cfg
  # directly -- it reads a stub at /boot/efi/EFI/<id>/grub.cfg. If that stub
  # is stale (copied by rsync from the live ESP) it points at the LIVE
  # system's /boot UUID and the image drops to "grub rescue>" when booted
  # on any other disk. We therefore install BOTH paths and rewrite the stub.
  local BLID
  # Read the id from the LIVE ESP: the image ESP is freshly formatted.
  # Prefer the directory that actually holds GRUB — an OEM folder such as
  # EFI/Dell sorts first alphabetically but is firmware data, not a loader.
  local D
  for D in /boot/efi/EFI/*/; do
    [ -e "${D}grubx64.efi" ] || [ -e "${D}shimx64.efi" ] || continue
    case "$(basename "${D}")" in BOOT|boot|Microsoft) continue ;; esac
    BLID="$(basename "${D}")"
    break
  done
  [ -z "${BLID}" ] && BLID="$(ls /boot/efi/EFI/ 2>/dev/null \
          | grep -viE '^(BOOT|Microsoft|tools|Dell|HP|Lenovo|ASUS|Acer|MSI|Gigabyte|INSYDE|OEM)$' | head -1)"
  [ -z "${BLID}" ] && BLID="$(sed -n 's|^GRUB_DISTRIBUTOR=.*"\?\([A-Za-z]\+\).*|\1|p' \
                              "${MNTPATH}/etc/default/grub" 2>/dev/null | tr 'A-Z' 'a-z' | head -1)"
  [ -z "${BLID}" ] && BLID="${OSID}"
  [ -z "${BLID}" ] && BLID="ubuntu"
  echo "  ESP bootloader-id: ${BLID}"

  local SECURE_BOOT=FALSE
  if chroot "${MNTPATH}" dpkg -l shim-signed &> /dev/null; then
    SECURE_BOOT=TRUE
    echo "  Secure Boot: shim-signed present (signed GRUB will be used)."
  else
    echo "  Secure Boot: shim-signed not available; unsigned GRUB will be used."
  fi

  # ---- Install 1: removable path  EFI/BOOT/BOOTX64.EFI ----
  local GRUB_OUT GRUB_RC
  GRUB_OUT="$(chroot "${MNTPATH}" grub-install \
    --target=x86_64-efi \
    --efi-directory=/boot/efi \
    --boot-directory=/boot \
    --no-nvram \
    --removable 2>&1)"
  GRUB_RC=$?
  if [ ${GRUB_RC} -ne 0 ]; then
    echo "  ERROR: grub-install (removable) failed:"
    echo "${GRUB_OUT}" | sed 's/^/    /'
    _grub_unmount
    errexit "GRUB installation failed — image would not be bootable."
  fi
  echo "  Installed: EFI/BOOT/BOOTX64.EFI (removable path)"

  # ---- Install 2: distro path  EFI/<id>/  (writes the prefix stub) ----
  GRUB_OUT="$(chroot "${MNTPATH}" grub-install \
    --target=x86_64-efi \
    --efi-directory=/boot/efi \
    --boot-directory=/boot \
    --bootloader-id="${BLID}" \
    --no-nvram 2>&1)"
  GRUB_RC=$?
  if [ ${GRUB_RC} -ne 0 ]; then
    echo "  WARNING: grub-install (${BLID}) returned non-zero:"
    echo "${GRUB_OUT}" | sed 's/^/    /'
  else
    echo "  Installed: EFI/${BLID}/ (signed-GRUB prefix path)"
  fi

  if [ "${ENCRYPTED}" = "TRUE" ]; then
    _configure_grub_for_luks
    echo "  Rebuilding initramfs for LUKS/LVM..."
    chroot "${MNTPATH}" update-initramfs -u -k all &> /dev/null || \
      echo "  WARNING: update-initramfs failed — manual rebuild may be needed."
  fi

  # ---- Regenerate grub.cfg (errors are FATAL, not swallowed) ----
  echo "  Running update-grub..."
  GRUB_OUT="$(chroot "${MNTPATH}" update-grub 2>&1)"
  GRUB_RC=$?
  if [ ${GRUB_RC} -ne 0 ]; then
    echo "  ERROR: update-grub failed:"
    echo "${GRUB_OUT}" | sed 's/^/    /'
    _grub_unmount
    errexit "grub.cfg generation failed — image would drop to GRUB rescue."
  fi

  # ---- Rewrite the ESP prefix stub with the IMAGE's UUIDs ----
  _write_esp_stub "${BLID}"

  # ---- Verify grub.cfg points at the IMAGE, not the live system ----
  _verify_grub_config

  _grub_unmount
  echo "  GRUB installation complete."
}

_grub_unmount()
{
  umount "${MNTPATH}/run"     &> /dev/null
  umount "${MNTPATH}/proc"    &> /dev/null
  umount "${MNTPATH}/sys"     &> /dev/null
  umount "${MNTPATH}/dev/pts" &> /dev/null
  umount "${MNTPATH}/dev"     &> /dev/null
}

# Write the grub.cfg stub that the signed grubx64.efi reads from the ESP.
#
# A plain "search.fs_uuid <uuid> root" stub can fail on some firmware even
# when the UUID is correct (observed on real hardware: the identical command
# succeeds when typed at the prompt). When it fails, $root silently stays on
# the ESP and the machine stops at a bare "grub>" prompt. This stub tries
# three lookups and only accepts a result that carries this image's own
# marker file, so it can never pick up another disk's grub.cfg.
_write_esp_stub()
{
  local BLID="$1"
  local GRUBFS_DEV GRUBFS_PART PREFIX_PATH

  if [ "${THREE_PART}" = "TRUE" ]; then
    GRUBFS_DEV="${LOOP}p2";                GRUBFS_PART=2; PREFIX_PATH="/grub"
  else
    GRUBFS_DEV="${LOOP}p${ROOT_PART_NUM}"; GRUBFS_PART="${ROOT_PART_NUM}"; PREFIX_PATH="/boot/grub"
  fi

  GRUBFS_UUID="$(fs_uuid "${GRUBFS_DEV}")"
  if [ -z "${GRUBFS_UUID}" ]; then
    _grub_unmount
    errexit "Could not read the UUID of ${GRUBFS_DEV} -- ESP stub cannot be written.\nAborting: the image would stop at a grub> prompt."
  fi

  # Marker file unique to this image; excluded from rsync so updates keep it.
  rm -f "${MNTPATH}/boot/grub/.imgbak-"* 2>/dev/null
  echo "image-backup ${IMGFILE} $(date -Is)" > "${MNTPATH}/boot/grub/.imgbak-${GRUBFS_UUID}"

  local STUB_TEXT
  STUB_TEXT="$(sed -e "s|@UUID@|${GRUBFS_UUID}|g" \
                   -e "s|@PREFIX@|${PREFIX_PATH}|g" \
                   -e "s|@PARTNUM@|${GRUBFS_PART}|g" << 'STUB'
# Generated by image-backup. Points this ESP at the image's own /boot
# filesystem. Do not copy this file to another disk.
set imgbak_prefix=@PREFIX@
set imgbak_marker=@PREFIX@/.imgbak-@UUID@

# 1) By filesystem UUID
search --no-floppy --fs-uuid --set=root @UUID@

# 2) Partition @PARTNUM@ on the same disk as this ESP
if [ ! -e "($root)$imgbak_marker" ]; then
  if regexp --set 1:imgbak_disk '^\(([^,)]+)' "$cmdpath"; then
    set root="$imgbak_disk,gpt@PARTNUM@"
  fi
fi

# 3) Any disk carrying this image's unique marker file
if [ ! -e "($root)$imgbak_marker" ]; then
  search --no-floppy --file --set=root $imgbak_marker
fi

set prefix=($root)$imgbak_prefix
configfile $prefix/grub.cfg
STUB
)"

  # Write to every GRUB directory on the ESP (EFI/BOOT, EFI/<id>, and
  # EFI/ubuntu, which is the prefix baked into Ubuntu's signed GRUB and
  # is also used by derivatives such as Zorin and Mint).
  local DIR WRITTEN=""
  for DIR in "${MNTPATH}/boot/efi/EFI/BOOT" \
             "${MNTPATH}/boot/efi/EFI/${BLID}" \
             "${MNTPATH}/boot/efi/EFI/ubuntu" \
             "${MNTPATH}"/boot/efi/EFI/*/; do
    DIR="${DIR%/}"
    case "$(basename "${DIR}")" in Microsoft|tools|'*') continue ;; esac
    [[ " ${WRITTEN} " == *" ${DIR} "* ]] && continue
    mkdir -p "${DIR}"
    printf '%s\n' "${STUB_TEXT}" > "${DIR}/grub.cfg"
    WRITTEN+=" ${DIR}"
  done
  echo "  ESP stub written to:$(echo "${WRITTEN}" | sed "s|${MNTPATH}/boot/efi/| |g")"
  echo "  GRUB filesystem UUID: ${GRUBFS_UUID} (partition ${GRUBFS_PART})"
}

# Hard-fail if grub.cfg does not point at the image or still points at the
# live system. A backup that reports success must be bootable.
_verify_grub_config()
{
  local CFG="${MNTPATH}/boot/grub/grub.cfg"
  if [ ! -s "${CFG}" ]; then
    _grub_unmount
    errexit "grub.cfg is missing or empty in the image."
  fi

  if ! grep -q "${GRUBFS_UUID}" "${CFG}"; then
    _grub_unmount
    errexit "grub.cfg does not reference the image's /boot filesystem (${GRUBFS_UUID}).\nThe image would not boot."
  fi

  local LIVE_UUID
  for LIVE_UUID in "$(fs_uuid "${ROOT_PART}")" \
                   "$( [ -n "${LIVE_BOOT_DEV}" ] && fs_uuid "${LIVE_BOOT_DEV}" )"; do
    [ -z "${LIVE_UUID}" ] && continue
    if grep -q "${LIVE_UUID}" "${CFG}"; then
      _grub_unmount
      errexit "grub.cfg still references the LIVE system's UUID ${LIVE_UUID}.\nThe image would boot the source disk or stop at a GRUB prompt."
    fi
  done

  if [ "${ENCRYPTED}" = "TRUE" ] && [ -n "${IMG_VG_NAME}" ]; then
    local IMG_MAP="${IMG_VG_NAME//-/--}-${IMG_LV_NAME//-/--}"
    local LIVE_MAP="${VG_NAME//-/--}-${LV_NAME//-/--}"
    local IMG_LV_UUID
    IMG_LV_UUID="$(fs_uuid "${IMG_LV_PATH}")"
    if grep -qF "/dev/mapper/${LIVE_MAP}" "${CFG}"; then
      _grub_unmount
      errexit "grub.cfg still points at the LIVE volume /dev/mapper/${LIVE_MAP}."
    fi
    if ! grep -qF "${IMG_MAP}" "${CFG}" && ! { [ -n "${IMG_LV_UUID}" ] && grep -qF "${IMG_LV_UUID}" "${CFG}"; }; then
      _grub_unmount
      errexit "grub.cfg does not reference the image's root volume (${IMG_MAP})."
    fi
    echo "  Verified: grub.cfg root volume is the image's (${IMG_MAP})"
  fi

  if ! ls "${MNTPATH}"/boot/vmlinuz-* &> /dev/null; then
    _grub_unmount
    errexit "No kernel (vmlinuz-*) found in the image's /boot."
  fi

  echo "  Verified: grub.cfg targets image UUID ${GRUBFS_UUID}; no live UUIDs; kernel present"
}

_configure_grub_for_luks()
{
  local IMG_LUKS_UUID
  IMG_LUKS_UUID="$(fs_uuid "${LOOP}p${ROOT_PART_NUM}")"

  # GRUB root device string using doubled-hyphen convention for LVM
  local ROOT_MAPPER_GRUB
  if [ -n "${IMG_VG_NAME}" ]; then
    local VG_GRUB="${IMG_VG_NAME//-/--}"
    local LV_GRUB="${IMG_LV_NAME//-/--}"
    ROOT_MAPPER_GRUB="/dev/mapper/${VG_GRUB}-${LV_GRUB}"
  else
    ROOT_MAPPER_GRUB="/dev/mapper/${IMG_LUKS_MAPPER}"
  fi

  local GRUB_DEFAULT="${MNTPATH}/etc/default/grub"
  if [ -f "${GRUB_DEFAULT}" ]; then
    # Clean any prior crypto params
    sed -i 's|cryptdevice=[^ "]*||g' "${GRUB_DEFAULT}"
    sed -i 's|rd\.luks\.uuid=[^ "]*||g' "${GRUB_DEFAULT}"
    # Ubuntu/Debian unlock from /etc/crypttab inside the initramfs, so only
    # root= is needed here; it also overrides anything stale from the source.
    sed -i "s|^GRUB_CMDLINE_LINUX=\"\(.*\)\"|GRUB_CMDLINE_LINUX=\"\1 root=${ROOT_MAPPER_GRUB}\"|" \
      "${GRUB_DEFAULT}"
    # Enable GRUB cryptodisk module (needed to unlock LUKS before loading kernel)
    grep -q "GRUB_ENABLE_CRYPTODISK" "${GRUB_DEFAULT}" || \
      echo 'GRUB_ENABLE_CRYPTODISK=y' >> "${GRUB_DEFAULT}"
    grep -q "GRUB_PRELOAD_MODULES" "${GRUB_DEFAULT}" || \
      echo 'GRUB_PRELOAD_MODULES="part_gpt luks2 cryptodisk lvm"' >> "${GRUB_DEFAULT}"
  fi

  _update_image_crypttab "${IMG_LUKS_UUID}"
  _fix_image_lvm_devices_file
  _fix_image_resume
}

# LVM's devices file (Ubuntu 22.04+) lists the exact PVs LVM may use. The
# copy inherited from the live system names the LIVE PV, so a restored image
# would ignore its own PV and fail to find root in the initramfs. Removing it
# restores "scan every device", which is what a cloned disk needs. Must run
# before update-initramfs, which bakes this file into the initrd.
_fix_image_lvm_devices_file()
{
  local DEVFILE="${MNTPATH}/etc/lvm/devices/system.devices"
  if [ -f "${DEVFILE}" ]; then
    rm -f "${DEVFILE}"
    echo "  Removed stale LVM devices file (image will scan all devices)"
  fi
}

# A RESUME= pointing at a hibernation device that does not exist on the
# restored disk makes boot wait for it. Drop it unless it names a device
# that is actually present in the image.
_fix_image_resume()
{
  local RESUMEFILE="${MNTPATH}/etc/initramfs-tools/conf.d/resume"
  [ -f "${RESUMEFILE}" ] || return
  local SPEC
  SPEC="$(sed -n 's|^RESUME=\(.*\)$|\1|p' "${RESUMEFILE}" | tr -d '"' | head -1)"
  [ -z "${SPEC}" ] && return
  [ "${SPEC}" = "none" ] && return
  if [ -n "${IMG_LV_PATH}" ] && [ "${SPEC}" = "${IMG_LV_PATH}" ]; then
    return
  fi
  echo "RESUME=none" > "${RESUMEFILE}"
  echo "  Disabled stale hibernation resume device (${SPEC})"
}

# =============================================================================
# FSTAB / CRYPTTAB FIXUP
# =============================================================================

_update_image_fstab()
{
  local FSTAB="${MNTPATH}/etc/fstab"
  [ -f "${FSTAB}" ] || return

  local IMG_EFI_UUID IMG_BOOT_UUID
  IMG_EFI_UUID="$(fs_uuid "${LOOP}p1")"
  [ "${THREE_PART}" = "TRUE" ] && IMG_BOOT_UUID="$(fs_uuid "${LOOP}p2")"

  # EFI partition
  if [ -n "${IMG_EFI_UUID}" ]; then
    sed -i "/^[[:space:]]*#/!s|^[^ ]*\(\s\+/boot/efi\s\)|UUID=${IMG_EFI_UUID}\1|" "${FSTAB}"
  fi

  # /boot partition
  if [ "${THREE_PART}" = "TRUE" ] && [ -n "${IMG_BOOT_UUID}" ]; then
    sed -i "/^[[:space:]]*#/!s|^[^ ]*\(\s\+/boot\s\)|UUID=${IMG_BOOT_UUID}\1|" "${FSTAB}"
  fi

  # Root partition / LV
  if [ "${ENCRYPTED}" = "TRUE" ]; then
    if [ -n "${IMG_VG_NAME}" ]; then
      local VG_FSTAB="${IMG_VG_NAME//-/--}"
      local LV_FSTAB="${IMG_LV_NAME//-/--}"
      local ROOT_MAP="/dev/mapper/${VG_FSTAB}-${LV_FSTAB}"
      sed -i "/^[[:space:]]*#/!s|^[^ ]*\(\s\+/\s\+ext4\)|${ROOT_MAP}\1|" "${FSTAB}"
    else
      local MAP_UUID
      MAP_UUID="$(fs_uuid "${IMG_LV_PATH}")"
      [ -n "${MAP_UUID}" ] && \
        sed -i "/^[[:space:]]*#/!s|^[^ ]*\(\s\+/\s\)|UUID=${MAP_UUID}\1|" "${FSTAB}"
    fi
  else
    local IMG_ROOT_UUID
    IMG_ROOT_UUID="$(fs_uuid "${LOOP}p${ROOT_PART_NUM}")"
    [ -n "${IMG_ROOT_UUID}" ] && \
      sed -i "/^[[:space:]]*#/!s|^[^ ]*\(\s\+/\s\)|UUID=${IMG_ROOT_UUID}\1|" "${FSTAB}"
  fi
}

# Entries other than /, /boot, /boot/efi and swap point at devices that
# will not exist on a restored disk (e.g. the backup drive itself at
# /mnt/usb). Without nofail, systemd waits 90 s per entry at boot and
# reports "Dependency failed for mnt-usb.mount". Add nofail and a short
# device timeout so the entry still mounts when the device is present.
_harden_fstab_extras()
{
  local FSTAB="${MNTPATH}/etc/fstab" TMP
  [ -f "${FSTAB}" ] || return
  TMP="$(mktemp)"
  awk '
    /^[[:space:]]*#/ || NF < 4 { print; next }
    {
      spec = $1; mp = $2; fstype = $3; opts = $4
      if (mp == "/" || mp == "/boot" || mp == "/boot/efi" || fstype == "swap" || mp == "none") { print; next }
      if (spec !~ /^(UUID=|PARTUUID=|LABEL=|PARTLABEL=|\/dev\/)/) { print; next }
      changed = 0
      if (opts !~ /(^|,)nofail(,|$)/)           { opts = opts ",nofail"; changed = 1 }
      if (opts !~ /x-systemd\.device-timeout=/) { opts = opts ",x-systemd.device-timeout=10s"; changed = 1 }
      if (!changed) { print; next }
      $4 = opts
      print "# image-backup: nofail added -- this device may be absent on a restored disk"
      print
      n++
    }
    END { if (n) printf "  fstab: %d non-system mount(s) marked nofail\n", n > "/dev/stderr" }
  ' OFS='\t' "${FSTAB}" > "${TMP}" && cat "${TMP}" > "${FSTAB}"
  rm -f "${TMP}"
}

_update_image_crypttab()
{
  local IMG_LUKS_UUID="$1"
  cat > "${MNTPATH}/etc/crypttab" << EOF
# /etc/crypttab - generated by image-backup
# Unlock LUKS container to access LVM root volume
${IMG_LUKS_MAPPER}   UUID=${IMG_LUKS_UUID}   none   luks,discard
EOF
}

# =============================================================================
# RESIZE-ON-RESTORE systemd SERVICE
# =============================================================================

inject_resize_service()
{
  local SVCFILE="${MNTPATH}/etc/systemd/system/resize-root-fs.service"
  local SCRIPTFILE="${MNTPATH}/usr/local/sbin/resize-root-fs"
  [ -f "${SVCFILE}" ] && return

  if [ "${ENCRYPTED}" = "TRUE" ] && [ -n "${VG_NAME}" ]; then
    cat > "${SCRIPTFILE}" << 'SCRIPT'
#!/bin/bash
# Grow LUKS partition -> LUKS mapping -> LVM PV -> root LV -> filesystem.
# Every layer has to grow in order; stopping early leaves the restored
# system at the shrunken backup size.
set -u
log() { echo "resize-root-fs: $*"; }

ROOT_SRC="$(findmnt -no SOURCE /)"
VG="$(lvs --noheadings -o vg_name "${ROOT_SRC}" 2>/dev/null | tr -d ' ')"
LV="$(lvs --noheadings -o lv_name "${ROOT_SRC}" 2>/dev/null | tr -d ' ')"
if [ -z "${VG}" ] || [ -z "${LV}" ]; then
  log "root ${ROOT_SRC} is not an LVM volume; nothing to do"
else
  PV="$(vgs --noheadings -o pv_name "${VG}" 2>/dev/null | tr -d ' ' | head -1)"
  CRYPT="$(basename "${PV}")"
  CHAIN="$(lsblk -rpsno NAME,TYPE "${PV}" 2>/dev/null)"
  LUKS_PART="$(awk '$2=="part"{print $1; exit}' <<< "${CHAIN}")"
  DISK="$(awk '$2=="disk"{print $1; exit}' <<< "${CHAIN}")"
  PARTNUM="$(grep -o '[0-9]*$' <<< "${LUKS_PART}")"

  if [ -n "${DISK}" ] && [ -n "${PARTNUM}" ]; then
    log "growing ${LUKS_PART} to fill ${DISK}"
    sgdisk -e "${DISK}" > /dev/null 2>&1
    INFO="$(sgdisk -i "${PARTNUM}" "${DISK}" 2>/dev/null)"
    START="$(sed -n 's|^First sector: \([0-9]*\).*|\1|p' <<< "${INFO}")"
    PGUID="$(sed -n 's|^Partition unique GUID: \([^ ]*\).*|\1|p' <<< "${INFO}")"
    if [ -n "${START}" ]; then
      sgdisk -d "${PARTNUM}" "${DISK}" > /dev/null 2>&1
      sgdisk -n "${PARTNUM}:${START}:0" -t "${PARTNUM}:8309" "${DISK}" > /dev/null 2>&1
      [ -n "${PGUID}" ] && sgdisk -u "${PARTNUM}:${PGUID}" "${DISK}" > /dev/null 2>&1
      # The disk is in use, so ask the kernel to update just this partition
      partx -u "${LUKS_PART}" 2>/dev/null || partprobe "${DISK}" 2>/dev/null
      sleep 1
    fi
  fi

  # Volume key is already in the kernel keyring, so no passphrase needed
  log "resizing LUKS mapping ${CRYPT}"
  cryptsetup resize "${CRYPT}" || log "cryptsetup resize failed"
  log "resizing PV ${PV}"
  pvresize "${PV}" > /dev/null 2>&1 || log "pvresize failed"
  log "extending ${VG}/${LV}"
  lvextend -l +100%FREE "${VG}/${LV}" > /dev/null 2>&1
  resize2fs "/dev/${VG}/${LV}"
  log "root filesystem is now $(df -h / | awk 'NR==2{print $2}')"
fi
systemctl disable resize-root-fs.service
rm -f /etc/systemd/system/resize-root-fs.service
rm -f /usr/local/sbin/resize-root-fs
SCRIPT
  else
    cat > "${SCRIPTFILE}" << 'SCRIPT'
#!/bin/bash
# Expand GPT partition and ext4 filesystem to fill disk
ROOT_PART="$(mount | sed -n 's|^\(/dev/[^ ]*\) on / .*|\1|p' | head -1)"
ROOT_DEV="$(lsblk -no pkname "${ROOT_PART}" 2>/dev/null)"
ROOT_DEV="/dev/${ROOT_DEV}"
PARTNUM="$(echo "${ROOT_PART}" | grep -o '[0-9]*$')"
START="$(sfdisk -d "${ROOT_DEV}" | grep "p\?${PARTNUM}\s" | sed 's/.*start= *\([0-9]*\).*/\1/')"
PARTUUID="$(blkid "${ROOT_PART}" | sed -n 's|.*PARTUUID="\([^"]*\)".*|\1|p')"
sgdisk -d "${PARTNUM}" "${ROOT_DEV}" > /dev/null
sgdisk -n "${PARTNUM}:${START}:0" -t "${PARTNUM}:8300" "${ROOT_DEV}" > /dev/null
[ -n "${PARTUUID}" ] && sgdisk -u "${PARTNUM}:${PARTUUID}" "${ROOT_DEV}" > /dev/null
partprobe "${ROOT_DEV}" 2>/dev/null
sleep 1
resize2fs "${ROOT_PART}"
systemctl disable resize-root-fs.service
rm -f /etc/systemd/system/resize-root-fs.service
rm -f /usr/local/sbin/resize-root-fs
SCRIPT
  fi
  chmod +x "${SCRIPTFILE}"

  cat > "${SVCFILE}" << 'SVC'
[Unit]
Description=Resize root filesystem to fill disk on first boot after restore
DefaultDependencies=no
Before=local-fs.target
After=systemd-remount-fs.service
ConditionPathExists=/usr/local/sbin/resize-root-fs

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/resize-root-fs
RemainAfterExit=yes
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
SVC

  mkdir -p "${MNTPATH}/etc/systemd/system/multi-user.target.wants/"
  ln -sf /etc/systemd/system/resize-root-fs.service \
         "${MNTPATH}/etc/systemd/system/multi-user.target.wants/resize-root-fs.service"
}

# =============================================================================
# RSYNC BACKUP CORE
# =============================================================================

backup()
{
  mntimg
  sync

  local EXCL=(
    "--exclude=${MNTPATH}"
    "--exclude=/dev"
    "--exclude=/lost+found"
    "--exclude=/media"
    "--exclude=/mnt"
    "--exclude=/proc"
    "--exclude=/run"
    "--exclude=/sys"
    "--exclude=/tmp"
    "--exclude=/var/swap"
    "--exclude=/var/cache/apt/archives"
    "--exclude=/etc/udev/rules.d/70-persistent-net.rules"
    "--exclude=/var/lib/asterisk/astdb.sqlite3-journal"
    "--exclude=/boot/grub/.imgbak-*"
  )

  _warn_skipped_mounts
  echo "  Running rsync (/)..."
  rsync -aHDx --partial --numeric-ids --delete --force \
    "${EXCL[@]}" "${OPTIONS[@]}" \
    / "${MNTPATH}/"
  local RC=$?
  if [[ ${RC} -ne 0 && ${RC} -ne 24 ]]; then
    errexit "rsync failed (exit code: ${RC})"
  fi

  # rsync -x does not cross into a separately mounted /boot, so on
  # 3-partition and LUKS systems the kernels and initrds would never reach
  # the image. Copy it as its own transfer.
  if [ "${THREE_PART}" = "TRUE" ] && mountpoint -q /boot; then
    echo "  Running rsync (/boot)..."
    rsync -aHDx --partial --numeric-ids --delete --force \
      --exclude='/efi' --exclude='/grub/.imgbak-*' "${OPTIONS[@]}" \
      /boot/ "${MNTPATH}/boot/"
    RC=$?
    if [[ ${RC} -ne 0 && ${RC} -ne 24 ]]; then
      errexit "rsync of /boot failed (exit code: ${RC})"
    fi
  fi

  # Recreate excluded virtual dirs
  mkdir -p "${MNTPATH}/dev/" "${MNTPATH}/lost+found/" "${MNTPATH}/media/" \
           "${MNTPATH}/mnt/" "${MNTPATH}/proc/"       "${MNTPATH}/run/"  \
           "${MNTPATH}/sys/" "${MNTPATH}/tmp/"
  chmod a+rwxt "${MNTPATH}/tmp/"

  _update_image_fstab
  _harden_fstab_extras

  [ "${NOEXPAND}" = "FALSE" ] && inject_resize_service

  sync
  umntimg

  # Copy filesystem labels
  mkloop
  fatlabel "${LOOP}p1" "$(fatlabel "${LIVE_EFI_DEV}" 2>/dev/null | tail -1)" &> /dev/null
  if [ "${THREE_PART}" = "TRUE" ] && [ -n "${LIVE_BOOT_DEV}" ]; then
    e2label "${LOOP}p2" "$(e2label "${LIVE_BOOT_DEV}" 2>/dev/null)" &> /dev/null
  fi
  if [ "${ENCRYPTED}" = "FALSE" ]; then
    e2label "${LOOP}p${ROOT_PART_NUM}" "$(e2label "${ROOT_PART}" 2>/dev/null)" &> /dev/null
  fi
  rmloop
}

# =============================================================================
# SHRINK ROOT FILESYSTEM TO MINIMUM
# =============================================================================

shrink_root_filesystem()
{
  echo ""
  echo "Shrinking root filesystem to minimum size..."

  if [ "${ENCRYPTED}" = "TRUE" ] && [ -n "${VG_NAME}" ]; then
    _shrink_luks_lvm
  elif [ "${ENCRYPTED}" = "TRUE" ]; then
    _shrink_luks_direct
  else
    _shrink_plain_ext4
  fi

  echo "  Shrink complete."
  echo "  Image size on disk: $(du -h "${IMGFILE}" | cut -f1)"
}

_shrink_plain_ext4()
{
  mkloop
  e2fsck -f -n "${LOOP}p${ROOT_PART_NUM}" || fsckerr "before"
  echo ""
  # Three passes ensures maximum shrink
  resize2fs -f -M "${LOOP}p${ROOT_PART_NUM}"
  resize2fs -f -M "${LOOP}p${ROOT_PART_NUM}"
  resize2fs -f -M "${LOOP}p${ROOT_PART_NUM}"
  e2fsck -f -n "${LOOP}p${ROOT_PART_NUM}" || fsckerr "after"

  local INFO NEWSIZE BLKSIZE START NEWEND
  INFO="$(tune2fs -l "${LOOP}p${ROOT_PART_NUM}" 2>/dev/null)"
  NEWSIZE="$(sed -n 's|^Block count:\s*\(.*\)|\1|p' <<< "${INFO}")"
  BLKSIZE="$(sed -n 's|^Block size:\s*\(.*\)|\1|p' <<< "${INFO}")"
  START="$(part_start "${IMGFILE}" "${ROOT_PART_NUM}")"
  if ! [[ "${START}" =~ ^[0-9]+$ ]] || [ "${START}" -lt 2048 ]; then
    errexit "Could not read partition ${ROOT_PART_NUM} start sector from ${IMGFILE}.\nAborting before truncate to avoid corrupting the image."
  fi
  NEWEND=$(( START + (NEWSIZE * (BLKSIZE / 512)) + ((ADDMB * ONEMB) / 512) - 1 + 33 ))

  CUR_BYTES="$(stat -c %s "${IMGFILE}")"
  if [ $(( (NEWEND + 1) * 512 )) -lt "${CUR_BYTES}" ]; then
    truncate -s $(( (NEWEND + 1) * 512 )) "${IMGFILE}"
    _rebuild_gpt "${START}" "8300" "Linux root"
  else
    echo "  Image is already at its minimum size — nothing to truncate."
  fi

  if [ "${ADDMB}" -ne 0 ]; then
    e2fsck -f -n "${LOOP}p${ROOT_PART_NUM}" || fsckerr "before expand"
    resize2fs -f "${LOOP}p${ROOT_PART_NUM}"
    e2fsck -f -n "${LOOP}p${ROOT_PART_NUM}" || fsckerr "after expand"
  fi
  rmloop
}

# Run an LVM/cryptsetup step non-interactively and surface any failure.
#
# These tools prompt on stdin in several situations (pvresize asks
# "Proceed? [y/n]" when asked for a size larger than the device). With output
# sent to /dev/null the prompt is invisible and the backup hangs forever, so
# every call closes stdin and keeps its output.
_run_step()
{
  local DESC="$1"; shift
  local OUT RC
  OUT="$("$@" 2>&1 </dev/null)"; RC=$?
  if [ ${RC} -ne 0 ]; then
    echo "    ${DESC} failed (exit ${RC}):"
    echo "${OUT}" | sed 's/^/      /'
  fi
  return ${RC}
}

_abort_luks_shrink()
{
  _deactivate_image_lvm
  cryptsetup close "${IMG_LUKS_MAPPER}" &> /dev/null
  IMG_MAPPER_OPEN=FALSE
  rmloop
}

_shrink_luks_lvm()
{
  mkloop
  _open_image_luks

  local LV_DEV="${IMG_LV_PATH}"
  local CRYPT_DEV="/dev/mapper/${IMG_LUKS_MAPPER}"
  local PART_DEV="${LOOP}p${ROOT_PART_NUM}"

  echo "  Phase 1: Shrink ext4 on ${LV_DEV}..."
  e2fsck -f -n "${LV_DEV}" || { _abort_luks_shrink; fsckerr "before"; }
  echo ""
  resize2fs -f -M "${LV_DEV}" </dev/null
  resize2fs -f -M "${LV_DEV}" </dev/null
  resize2fs -f -M "${LV_DEV}" </dev/null
  e2fsck -f -n "${LV_DEV}" || { _abort_luks_shrink; fsckerr "after"; }

  local INFO NEWSIZE BLKSIZE FS_BYTES TARGET_LV_BYTES
  INFO="$(tune2fs -l "${LV_DEV}" 2>/dev/null)"
  NEWSIZE="$(sed -n 's|^Block count:\s*\(.*\)|\1|p' <<< "${INFO}")"
  BLKSIZE="$(sed -n 's|^Block size:\s*\(.*\)|\1|p' <<< "${INFO}")"
  if ! [[ "${NEWSIZE}" =~ ^[0-9]+$ && "${BLKSIZE}" =~ ^[0-9]+$ ]]; then
    _abort_luks_shrink
    errexit "Could not read filesystem geometry from ${LV_DEV}."
  fi
  FS_BYTES=$(( NEWSIZE * BLKSIZE ))
  TARGET_LV_BYTES=$(( FS_BYTES + (ADDMB * ONEMB) ))

  # Current geometry, in 512-byte sectors
  local LV_SECTORS CRYPT_SECTORS PART_SECTORS HEADER_SECTORS
  LV_SECTORS="$(blockdev --getsz "${LV_DEV}" 2>/dev/null)"
  CRYPT_SECTORS="$(blockdev --getsz "${CRYPT_DEV}" 2>/dev/null)"
  PART_SECTORS="$(blockdev --getsz "${PART_DEV}" 2>/dev/null)"
  if ! [[ "${CRYPT_SECTORS}" =~ ^[0-9]+$ && "${PART_SECTORS}" =~ ^[0-9]+$ ]]; then
    _abort_luks_shrink
    errexit "Could not read device sizes for the image's LUKS container."
  fi
  HEADER_SECTORS=$(( PART_SECTORS - CRYPT_SECTORS ))   # LUKS header area

  echo "  Phase 2: Reduce logical volume..."
  if [ $(( TARGET_LV_BYTES / 512 )) -lt "${LV_SECTORS}" ]; then
    _run_step "lvreduce" lvreduce -y -f -L "${TARGET_LV_BYTES}B" \
      "${IMG_VG_NAME}/${IMG_LV_NAME}"
  else
    echo "    Filesystem is already at its minimum size — LV left unchanged."
  fi

  echo "  Phase 3: Resize LVM physical volume..."
  local PE_START EXT_SIZE ALLOC PV_NOW PV_NEED
  PE_START="$(pvs --noheadings --units b --nosuffix -o pe_start "${CRYPT_DEV}" 2>/dev/null | tr -d ' ')"
  EXT_SIZE="$(vgs --noheadings --units b --nosuffix -o vg_extent_size "${IMG_VG_NAME}" 2>/dev/null | tr -d ' ')"
  ALLOC="$(pvs --noheadings -o pv_pe_alloc_count "${CRYPT_DEV}" 2>/dev/null | tr -d ' ')"
  PV_NOW="$(pvs --noheadings --units b --nosuffix -o pv_size "${CRYPT_DEV}" 2>/dev/null | tr -d ' ')"
  if [[ "${PE_START}" =~ ^[0-9]+$ && "${EXT_SIZE}" =~ ^[0-9]+$ \
     && "${ALLOC}" =~ ^[0-9]+$ && "${PV_NOW}" =~ ^[0-9]+$ ]]; then
    PV_NEED=$(( PE_START + (ALLOC * EXT_SIZE) ))
    # Never request more than the device actually holds: pvresize would stop
    # and ask "Proceed? [y/n]", which is what used to hang the backup.
    if [ "${PV_NEED}" -lt "${PV_NOW}" ]; then
      _run_step "pvresize" pvresize -y --setphysicalvolumesize "${PV_NEED}B" "${CRYPT_DEV}" \
        || PV_NEED="${PV_NOW}"
    else
      echo "    PV already holds no spare extents — left unchanged."
      PV_NEED="${PV_NOW}"
    fi
  else
    echo "    WARNING: could not read PV geometry; leaving the PV unchanged."
    PV_NEED=$(( CRYPT_SECTORS * 512 ))
  fi

  echo "  Phase 4: Resize LUKS mapping..."
  local NEW_CRYPT_SECTORS=$(( (PV_NEED + 511) / 512 ))
  if [ "${NEW_CRYPT_SECTORS}" -lt "${CRYPT_SECTORS}" ]; then
    _run_step "cryptsetup resize" cryptsetup resize --size "${NEW_CRYPT_SECTORS}" \
      "${IMG_LUKS_MAPPER}" || NEW_CRYPT_SECTORS="${CRYPT_SECTORS}"
  else
    echo "    LUKS mapping already minimal — left unchanged."
    NEW_CRYPT_SECTORS="${CRYPT_SECTORS}"
  fi

  echo "  Phase 5: Close LUKS container..."
  _deactivate_image_lvm
  cryptsetup close "${IMG_LUKS_MAPPER}" &> /dev/null
  IMG_MAPPER_OPEN=FALSE

  echo "  Phase 6: Truncate image and rebuild GPT..."
  local NEW_PART_SECTORS=$(( HEADER_SECTORS + NEW_CRYPT_SECTORS ))
  if [ "${NEW_PART_SECTORS}" -ge "${PART_SECTORS}" ]; then
    echo "    Image is already at its minimum size — nothing to truncate."
    rmloop
    return 0
  fi

  local START
  START="$(part_start "${IMGFILE}" "${ROOT_PART_NUM}")"
  if ! [[ "${START}" =~ ^[0-9]+$ ]] || [ "${START}" -lt 2048 ]; then
    rmloop
    errexit "Could not read partition ${ROOT_PART_NUM} start sector from ${IMGFILE}.\nAborting before truncate to avoid corrupting the image."
  fi
  rmloop    # detach before changing the backing file's size
  truncate -s $(( (START + NEW_PART_SECTORS + 33) * 512 )) "${IMGFILE}"
  _rebuild_gpt "${START}" "8309" "Linux LUKS"
}

_shrink_luks_direct()
{
  mkloop
  _open_image_luks
  local CDEV="/dev/mapper/${IMG_LUKS_MAPPER}"
  local PART_DEV="${LOOP}p${ROOT_PART_NUM}"

  e2fsck -f -n "${CDEV}" || { _abort_luks_shrink; fsckerr "before"; }
  echo ""
  resize2fs -f -M "${CDEV}" </dev/null
  resize2fs -f -M "${CDEV}" </dev/null
  resize2fs -f -M "${CDEV}" </dev/null
  e2fsck -f -n "${CDEV}" || { _abort_luks_shrink; fsckerr "after"; }

  local INFO NEWSIZE BLKSIZE
  INFO="$(tune2fs -l "${CDEV}" 2>/dev/null)"
  NEWSIZE="$(sed -n 's|^Block count:\s*\(.*\)|\1|p' <<< "${INFO}")"
  BLKSIZE="$(sed -n 's|^Block size:\s*\(.*\)|\1|p' <<< "${INFO}")"
  if ! [[ "${NEWSIZE}" =~ ^[0-9]+$ && "${BLKSIZE}" =~ ^[0-9]+$ ]]; then
    _abort_luks_shrink
    errexit "Could not read filesystem geometry from ${CDEV}."
  fi

  local CRYPT_SECTORS PART_SECTORS HEADER_SECTORS NEW_SECTORS
  CRYPT_SECTORS="$(blockdev --getsz "${CDEV}" 2>/dev/null)"
  PART_SECTORS="$(blockdev --getsz "${PART_DEV}" 2>/dev/null)"
  HEADER_SECTORS=$(( PART_SECTORS - CRYPT_SECTORS ))
  NEW_SECTORS=$(( ((NEWSIZE * BLKSIZE) + (ADDMB * ONEMB) + 511) / 512 ))

  if [ "${NEW_SECTORS}" -lt "${CRYPT_SECTORS}" ]; then
    _run_step "cryptsetup resize" cryptsetup resize --size "${NEW_SECTORS}" \
      "${IMG_LUKS_MAPPER}" || NEW_SECTORS="${CRYPT_SECTORS}"
  else
    echo "    Filesystem is already at its minimum size — LUKS mapping unchanged."
    NEW_SECTORS="${CRYPT_SECTORS}"
  fi

  cryptsetup close "${IMG_LUKS_MAPPER}" &> /dev/null
  IMG_MAPPER_OPEN=FALSE

  local NEW_PART_SECTORS=$(( HEADER_SECTORS + NEW_SECTORS ))
  if [ "${NEW_PART_SECTORS}" -ge "${PART_SECTORS}" ]; then
    echo "    Image is already at its minimum size — nothing to truncate."
    rmloop
    return 0
  fi

  local START
  START="$(part_start "${IMGFILE}" "${ROOT_PART_NUM}")"
  if ! [[ "${START}" =~ ^[0-9]+$ ]] || [ "${START}" -lt 2048 ]; then
    rmloop
    errexit "Could not read partition ${ROOT_PART_NUM} start sector from ${IMGFILE}.\nAborting before truncate to avoid corrupting the image."
  fi
  rmloop
  truncate -s $(( (START + NEW_PART_SECTORS + 33) * 512 )) "${IMGFILE}"
  _rebuild_gpt "${START}" "8309" "Linux LUKS"
}

# Relocate GPT backup header and fix the root partition entry
_rebuild_gpt()
{
  local ROOT_START="$1" PART_TYPE="$2" PART_LABEL="$3"
  sgdisk -e "${IMGFILE}" &> /dev/null
  sgdisk -d "${ROOT_PART_NUM}" "${IMGFILE}" &> /dev/null
  sgdisk -n "${ROOT_PART_NUM}:${ROOT_START}:0" \
         -t "${ROOT_PART_NUM}:${PART_TYPE}" \
         -c "${ROOT_PART_NUM}:${PART_LABEL}" \
         "${IMGFILE}" &> /dev/null
}

# =============================================================================
# MAIN
# =============================================================================

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

if [ "$(id -u)" -ne 0 ]; then
  errexit "$0 must be run as root user"
fi

PGMNAME="$(basename "$0")"
for PID in $(pidof -x -o %PPID "${PGMNAME}"); do
  [ "${PID}" -ne $$ ] && errexit "${PGMNAME} is already running"
done

# Core dependency checks
check_dep gdisk      gdisk
check_dep sgdisk     gdisk
check_dep rsync      rsync
check_dep resize2fs  e2fsprogs
check_dep e2fsck     e2fsprogs
check_dep mkfs.vfat  dosfstools
check_dep mkfs.ext4  e2fsprogs
check_dep lsblk      util-linux
check_dep blkid      util-linux
check_dep grub-install grub-efi-amd64

OSID="$(sed -n 's|^ID=\(.*\)|\1|p' /etc/os-release)"

echo ""
echo "Detecting system layout..."

ROOT_PART="$(mount | sed -n 's|^\(/dev/[^ ]*\) on / .*|\1|p' | head -1)"
[ -z "${ROOT_PART}" ] && errexit "Cannot detect root partition"

detect_encryption

if [ "${ENCRYPTED}" = "TRUE" ]; then
  check_dep cryptsetup cryptsetup
  check_dep pvs        lvm2
  check_dep lvs        lvm2
  check_dep lvreduce   lvm2
  check_dep pvresize   lvm2
  check_dep vgchange   lvm2
  check_dep lvcreate   lvm2
  check_dep vgcreate   lvm2
  check_dep pvcreate   lvm2
fi

# Root disk comes from the device chain walked in detect_encryption;
# fall back to pkname only if that came up empty.
if [ -z "${ROOT_DISK}" ]; then
  if [ "${ENCRYPTED}" = "TRUE" ] && [ -n "${LUKS_DEV}" ]; then
    ROOT_DISK="/dev/$(lsblk -no pkname "${LUKS_DEV}" 2>/dev/null | head -1)"
  else
    ROOT_DISK="/dev/$(lsblk -no pkname "${ROOT_PART}" 2>/dev/null | head -1)"
  fi
fi
if [ -z "${ROOT_DISK}" ] || [ "${ROOT_DISK}" = "/dev/" ] || [ ! -b "${ROOT_DISK}" ]; then
  errexit "Cannot determine root disk device (got '${ROOT_DISK}')"
fi

# Partition layout
if [ "${ENCRYPTED}" = "TRUE" ]; then
  # LUKS systems must have a separate unencrypted /boot for GRUB
  THREE_PART=TRUE
elif grep -qsE '^\S+\s+/boot\s+ext[2-4]' /etc/fstab; then
  THREE_PART=TRUE
fi

if [ "${THREE_PART}" = "TRUE" ]; then
  ROOT_PART_NUM=3
  EFI_SIZE_MB=512
  # Size /boot from what the live system actually uses. A fixed 1 GB can
  # overflow on systems holding several kernels, and rsync would fail.
  BOOT_SIZE_MB=1024
  if mountpoint -q /boot; then
    BOOT_USED_MB=$(( $(df -Pk /boot | awk 'NR==2{print $3}') / 1024 ))
    BOOT_NEED_MB=$(( (BOOT_USED_MB * 2) + 256 ))
    [ ${BOOT_NEED_MB} -gt ${BOOT_SIZE_MB} ] && BOOT_SIZE_MB=${BOOT_NEED_MB}
  fi
  LIVE_EFI_DEV="$(awk '!/^[[:space:]]*#/ && $2=="/boot/efi" {print $1}' /etc/fstab | head -1)"
  LIVE_BOOT_DEV="$(awk '!/^[[:space:]]*#/ && $2=="/boot" && $3~/ext/ {print $1}' /etc/fstab | head -1)"
else
  ROOT_PART_NUM=2
  EFI_SIZE_MB=512
  BOOT_SIZE_MB=0
  LIVE_EFI_DEV="$(awk '!/^[[:space:]]*#/ && $2=="/boot/efi" {print $1}' /etc/fstab | head -1)"
  LIVE_BOOT_DEV=""
fi

resolve_dev()
{
  local spec="$1"
  if [[ "${spec}" =~ ^UUID= ]];     then blkid -U "${spec#UUID=}" 2>/dev/null
  elif [[ "${spec}" =~ ^PARTUUID= ]]; then blkid -t "PARTUUID=${spec#PARTUUID=}" -o device 2>/dev/null | head -1
  else echo "${spec}"; fi
}
LIVE_EFI_DEV="$(resolve_dev "${LIVE_EFI_DEV}")"
[ "${THREE_PART}" = "TRUE" ] && LIVE_BOOT_DEV="$(resolve_dev "${LIVE_BOOT_DEV}")"

echo "  OS             : ${OSID}"
echo "  Root partition : ${ROOT_PART}"
echo "  Root disk      : ${ROOT_DISK}"
echo "  Layout         : $([ "${THREE_PART}" = "TRUE" ] && echo "3-part (EFI+boot+root)" || echo "2-part (EFI+root)")"
echo "  Encrypted      : ${ENCRYPTED}"

DFKFREE="$(df / | awk 'NR==2{print $3}')"
INISIZE=$(( (DFKFREE + (DFKFREE / 5)) / 1024 ))

IMGNAME="" IMGSIZE="" IMGINCR="" IMGFILE=""
OPTIONS=() NOEXPAND=FALSE ADDMB=0

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)       usage ;;
    -i|--initial)
      OIFS=${IFS}; IFS=','
      INITIAL=($2); IFS=${OIFS}
      IMGNAME="${INITIAL[0]}"
      IMGSIZE="${INITIAL[1]}"
      IMGINCR="${INITIAL[2]}"
      shift 2 ;;
    -n|--noexpand)   NOEXPAND=TRUE; shift ;;
    -o|--options)
      OIFS=${IFS}; IFS=','
      OPTIONS+=($2); IFS=${OIFS}
      shift 2 ;;
    -u|--ubuntu)     OSID="ubuntu"; shift ;;
    -p|--passphrase) IMG_LUKS_PASSPHRASE="$2"; shift 2 ;;
    -*|--*)          usage ;;
    *)               IMGFILE="$1"; shift ;;
  esac
done

# =============================================================================
# INITIAL BACKUP
# =============================================================================
if [ -z "${IMGFILE}" ]; then

  if [ -n "${IMGNAME}" ]; then
    IMGFILE="${IMGNAME}"
    [ -d "${IMGFILE}" ] && errexit "${IMGFILE} is a directory"
    [ -z "${IMGSIZE}" ] && IMGSIZE=${INISIZE}
    IRFSSIZE="${IMGSIZE}"
    [ -z "${IMGINCR}" ] && IMGINCR=0
    ADDMB="${IMGINCR}"
  else
    while :; do
      echo ""
      read -r -e -i "${IMGFILE}" -p "Image file to create? " IMGFILE
      [ -z "${IMGFILE}" ] && continue
      if [ -d "${IMGFILE}" ]; then
        echo ""; echo "${IMGFILE} is a directory"
      elif [ -f "${IMGFILE}" ]; then
        echo ""
        echo -n "${IMGFILE} already exists, Ok to delete (y/n)? "
        while read -r -n 1 -s a; do
          if [[ "${a}" = [yYnN] ]]; then
            echo "${a}"
            [[ "${a}" = [yY] ]] && break 2 || break 1
          fi
        done
      else
        break
      fi
    done
    echo ""
    read -r -e -p "Initial image file ROOT filesystem size (MB) [${INISIZE}]? " IRFSSIZE
    [ -z "${IRFSSIZE}" ] && IRFSSIZE=${INISIZE}
    echo ""
    read -r -e -p "Added space for incremental updates after shrinking (MB) [0]? " ADDMB
    [ -z "${ADDMB}" ] && ADDMB=0
    echo ""
    echo -n "Create ${IMGFILE} (y/n)? "
    while read -r -n 1 -s a; do
      if [[ "${a}" = [yYnN] ]]; then
        echo "${a}"
        [[ "${a}" = [yY] ]] && break || errexit "Aborted"
      fi
    done
  fi

  [ -f "${IMGFILE}" ] && { rm "${IMGFILE}" || errexit "Unable to delete existing image file"; }

  TOTAL_MB=$(( IRFSSIZE + EFI_SIZE_MB + BOOT_SIZE_MB ))
  truncate -s $(( TOTAL_MB * ONEMB )) "${IMGFILE}" || errexit "Unable to create image file"

  # Partition — GPT only, UEFI only
  sgdisk -Z "${IMGFILE}" &> /dev/null
  sgdisk -n 1:0:+${EFI_SIZE_MB}M  -t 1:ef00 -c 1:"EFI System"  "${IMGFILE}" &> /dev/null
  if [ "${THREE_PART}" = "TRUE" ]; then
    sgdisk -n 2:0:+${BOOT_SIZE_MB}M -t 2:8300 -c 2:"Linux boot" "${IMGFILE}" &> /dev/null
    if [ "${ENCRYPTED}" = "TRUE" ]; then
      sgdisk -n 3:0:0               -t 3:8309 -c 3:"Linux LUKS" "${IMGFILE}" &> /dev/null
    else
      sgdisk -n 3:0:0               -t 3:8300 -c 3:"Linux root" "${IMGFILE}" &> /dev/null
    fi
  else
    sgdisk -n 2:0:0                 -t 2:8300 -c 2:"Linux root" "${IMGFILE}" &> /dev/null
  fi

  # Format partitions
  mkloop
  mkfs.vfat -F 32 -n "EFI" "${LOOP}p1" &> /dev/null || errexit "Unable to create EFI filesystem"
  dosfsck "${LOOP}p1" > /dev/null
  if [ "${THREE_PART}" = "TRUE" ]; then
    mkfs.ext4 -b 4096 -L boot -q "${LOOP}p2" > /dev/null \
      || errexit "Unable to create /boot filesystem (${BOOT_SIZE_MB} MB)"
  fi
  if [ "${ENCRYPTED}" = "FALSE" ]; then
    mkfs.ext4 -b 4096 -L rootfs -q "${LOOP}p${ROOT_PART_NUM}" > /dev/null \
      || errexit "Unable to create ROOT filesystem"
  fi
  rmloop

  # LUKS setup (if encrypted)
  if [ "${ENCRYPTED}" = "TRUE" ]; then
    mkloop
    setup_luks_image
    # Close here — backup()->mntimg() will reopen
    _deactivate_image_lvm
    cryptsetup close "${IMG_LUKS_MAPPER}" &> /dev/null
    IMG_MAPPER_OPEN=FALSE
    rmloop
  fi

  echo ""
  echo "Starting full backup..."
  echo "(For incremental updates: $0 ${IMGFILE})"
  backup

  # Install GRUB EFI (+ Secure Boot shim if available)
  mntimg
  install_grub
  umntimg

  # Shrink root to minimum size
  shrink_root_filesystem

  echo ""

else

  # =============================================================================
  # INCREMENTAL UPDATE
  # =============================================================================
  [ -d "${IMGFILE}" ] && errexit "${IMGFILE} is a directory"
  [ ! -f "${IMGFILE}" ] && errexit "${IMGFILE} not found"

  # Detect image layout from the file itself
  LOOP_TMP="$(losetup -f --show -P "${IMGFILE}")"
  loop_settle "${LOOP_TMP}" || errexit "Loop partition devices did not appear"
  NUM_PARTS="$(count_parts "${IMGFILE}")"
  losetup -d "${LOOP_TMP}"
  if [ "${NUM_PARTS}" -ge 3 ]; then
    THREE_PART=TRUE; ROOT_PART_NUM=3
  else
    THREE_PART=FALSE; ROOT_PART_NUM=2
  fi

  if [ "${ENCRYPTED}" = "TRUE" ] && [ -z "${IMG_LUKS_PASSPHRASE}" ]; then
    echo -n "Enter the image's LUKS passphrase: "
    read -rs IMG_LUKS_PASSPHRASE; echo ""
  fi

  echo ""
  echo "Starting incremental update..."
  backup

  # rsync has just replaced the image's grub.cfg (and on LUKS systems its
  # crypttab and initrd) with the live system's copies, which reference the
  # live disk. Regenerate them against the image, exactly as the initial
  # backup does.
  mntimg
  install_grub
  umntimg

fi

sync
echo ""
echo "====================================================="
echo "Backup complete : ${IMGFILE}"
echo "Image size      : $(du -h "${IMGFILE}" 2>/dev/null | cut -f1)"
echo "====================================================="
echo ""